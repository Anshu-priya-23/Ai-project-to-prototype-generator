# AI_API_KEY is the only value required for local Docker Compose.
# Infrastructure settings below have safe local defaults in docker-compose.yml.
# Uncomment them only to override a fresh local environment. Existing PostgreSQL
# volumes retain the credentials used when they were first initialized.
# POSTGRES_DB=enterprise_db
# POSTGRES_USER=root
# POSTGRES_PASSWORD=password
# JWT_SECRET=local-development-jwt-secret-change-me-1234567890
# RABBITMQ_DEFAULT_USER=guest
# RABBITMQ_DEFAULT_PASS=guest
# RABBITMQ_ERLANG_COOKIE=local-development-erlang-cookie
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Used only when building the frontend outside local Vite development.
VITE_API_BASE_URL=

# Render-only values are documented in README.md. Production uses:
# PROTOTYPE_GENERATION_MODE=sync
# RABBIT_HEALTH_ENABLED=false
# AUTH_SERVICE_BASE_URL=https://prototype-auth-service.onrender.com
# PROJECT_SERVICE_BASE_URL=https://prototype-project-service.onrender.com
# AI_SERVICE_BASE_URL=https://prototype-ai-service.onrender.com
