# Local Docker Compose values only. Copy to .env and replace every placeholder.
POSTGRES_DB=prototype_db
POSTGRES_USER=prototype_user
POSTGRES_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
RABBITMQ_DEFAULT_USER=prototype_app
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-local-password
RABBITMQ_ERLANG_COOKIE=replace-with-a-long-random-cookie
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Used only when building the frontend outside local Vite development.
VITE_API_BASE_URL=

# Render-only values are documented in README.md. Production uses:
# PROTOTYPE_GENERATION_MODE=sync
# RABBIT_HEALTH_ENABLED=false
# AUTH_SERVICE_BASE_URL=https://prototype-auth-service.onrender.com
# PROJECT_SERVICE_BASE_URL=https://prototype-project-service.onrender.com
# AI_SERVICE_BASE_URL=https://prototype-ai-service.onrender.com
